# Copy to .env at the root of this repository. A value already in the environment wins.
# Never commit .env.

# The 4genthub server this machine reports to, and your key for it.
AGENTHUB_URL=https://api.4genthub.com
AGENTHUB_TOKEN=

# The bridge reports this machine's seat status with its own token (see `4genteam bridge register`).
AGENTHUB_MACHINE_TOKEN=

# OpenRig daemon (defaults shown).
OPENRIG_URL=http://127.0.0.1:7433
OPENRIG_PORT=7433

# Compaction supervisor: compact at the next quiet moment above LIMIT, without waiting above HARD.
COMPACT_LIMIT_TOKENS=150000
COMPACT_WARN_TOKENS=
COMPACT_HARD_TOKENS=300000
COMPACT_QUIET_SECONDS=15

# Only for `4genteam team publish-skills`: the OpenRig checkout the inventory paths are relative to.
OPENRIG_SKILLS_ROOT=
