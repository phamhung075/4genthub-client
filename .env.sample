# 4genthub client configuration: ONE file, ONE credential.
#
# The client reads this file at ~/.config/4genthub/.env, resolved from your real home, so it is the
# same file inside a seat and out. Copy it there and fill in AGENTHUB_TOKEN:
#
#   mkdir -p ~/.config/4genthub
#   cp .env.sample ~/.config/4genthub/.env
#
# A variable already set in the environment WINS over this file, so the file supplies a default and
# never overrides a shell that already has the value; a missing file is not an error, because the
# client is usable from the environment alone. KEY=VALUE, an optional `export ` prefix, blank lines,
# `#` comments and quoted values are all accepted.
#
# Never commit this file, and never copy the token anywhere else: not into .mcp.json, not into a
# command line, not into a message. This sample carries no token value.

# The server this machine reports to, and your key for it. Both are required: the verbs that talk to
# the cloud refuse without them and name both.
AGENTHUB_URL=https://api.4genthub.com
AGENTHUB_TOKEN=

# The compaction supervisor's limits. A blank value means: use the default shown. A value that is
# present and not a whole number is refused by name instead of being ignored.
# COMPACT_LIMIT_TOKENS is the soft limit: the seat is told to find its own safe point, and it is
# compacted once it goes quiet. COMPACT_WARN_TOKENS is urgent: compacted without waiting for quiet.
# COMPACT_HARD_TOKENS is the ceiling at which the running turn is aborted and compaction forced.
# COMPACT_QUIET_SECONDS is how long without output counts as quiet.
COMPACT_LIMIT_TOKENS=150000
COMPACT_WARN_TOKENS=200000
COMPACT_HARD_TOKENS=250000
COMPACT_QUIET_SECONDS=15

# DeepSeek off-peak billing & provider credentials. The gate refuses to START or RESUME a seat whose
# model is `deepseek/` inside a peak window (01:00-04:00 and 06:00-10:00 UTC, Monday-Friday), because
# that is the expensive rate. On by default, since the expensive default is the one nobody had to remember.
# `4genteam offpeak` answers the schedule and its exit code is the answer (0 off-peak, 1 peak);
# `4genteam offpeak set off` writes this line for you. A value that is not 1/on/0/off is refused by name.
OFFPEAK_ONLY=1
DEEPSEEK_API_KEY=

# TypeSafe AI / Jev System One validation gate credentials. Used to evaluate task acceptance criteria
# upon completion evidence submission and room decision evaluation.
# NOTE: User/client PC runs seat LLMs (Gemini, DeepSeek, Claude Code) locally and uses Jev token for AI calls/sessions;
# the backend server does not handle or host client LLMs.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Jev AI Decision Auto-Selection threshold and benchmark logging:
# Auto-selects decision options if Jev confidence >= threshold; leaves pending for human if below.
JEV_DECISION_THRESHOLD=0.8
JEV_DECISION_MODEL=jev-1.13.0
JEV_DECISION_LOG_PATH=~/.config/4genthub/jev_decisions.log

# Optional overrides for DeepSeek off-peak schedule:
# OFFPEAK_UTC=2026-10-10 12:00
# DEEPSEEK_HOLIDAYS=/path/to/holidays.txt
