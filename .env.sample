# 4genthub client configuration: ONE file, ONE credential.
#
# Copy this file to ~/.config/4genthub/.env and fill in AGENTHUB_TOKEN:
#
#   mkdir -p ~/.config/4genthub
#   cp .env.sample ~/.config/4genthub/.env
#
# A variable already set in the environment WINS over this file, so the file supplies a default
# and never overrides a shell that already has the value. Never commit this file, and never copy
# the token anywhere else: not into .mcp.json, not into a command line, not into a message.

# The server this machine reports to, and your key for it. Both are required.
AGENTHUB_URL=https://api.4genthub.com
AGENTHUB_TOKEN=

# The OpenRig daemon. Defaults shown.
OPENRIG_URL=http://127.0.0.1:7433
OPENRIG_PORT=7433

# The compaction supervisor's limits. A blank value means: use the default shown.
# COMPACT_LIMIT_TOKENS is the soft limit: the seat is told to find a safe point, and it is
# compacted once it goes quiet. COMPACT_WARN_TOKENS is urgent: compacted without waiting for
# quiet. COMPACT_HARD_TOKENS is the ceiling at which the running turn is aborted and compaction
# forced. COMPACT_QUIET_SECONDS is how long without output counts as quiet.
COMPACT_LIMIT_TOKENS=150000
COMPACT_WARN_TOKENS=250000
COMPACT_HARD_TOKENS=300000
COMPACT_QUIET_SECONDS=15

# Only for `4genteam team publish-skills` and `4genteam team drift-check`: the skill library
# checkout the inventory's recorded paths are relative to. Blank means those verbs need
# --source-root or --library-root.
OPENRIG_SKILLS_ROOT=
