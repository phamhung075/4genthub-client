# 4genthub client configuration: ONE file, ONE credential.
#
# The client reads this file at ~/.config/4genthub/.env, resolved from your real home, so it is the
# same file inside a seat and out. Copy it there and fill in AGENTHUB_TOKEN:
#
#   mkdir -p ~/.config/4genthub
#   cp .env.sample ~/.config/4genthub/.env
#
# A variable already set in the environment WINS over this file, so the file supplies a default and
# never overrides a shell that already has the value; a missing file is not an error, because the
# client is usable from the environment alone. KEY=VALUE, an optional `export ` prefix, blank lines,
# `#` comments and quoted values are all accepted.
#
# Never commit this file, and never copy the token anywhere else: not into .mcp.json, not into a
# command line, not into a message. This sample carries no token value.

# The server this machine reports to, and your key for it. Both are required: the verbs that talk to
# the cloud refuse without them and name both.
AGENTHUB_URL=https://api.4genthub.com
AGENTHUB_TOKEN=

# The OpenRig daemon. Both defaults are shown; OPENRIG_PORT wins if both are set.
OPENRIG_URL=http://127.0.0.1:7433
OPENRIG_PORT=7433

# The state root for every verb that needs one: --state-root, else this, else ~/.openrig/state/omp. A
# verb that can resolve none of the three refuses and names both escapes rather than guessing. Blank
# means: the default.
OPENRIG_STATE_ROOT=

# Only for `4genteam team publish-skills` and `4genteam team drift-check`: the skill library checkout
# the inventory's recorded paths are relative to. It is the default for --source-root and
# --library-root, so leaving it blank means those verbs need the flag.
OPENRIG_SKILLS_ROOT=

# This client's own skills tree (skills/share, skills/rooms/<room>, skills/client), used when no
# --skills-root flag is given, and defaulting to skills/ beside the binary. Deliberately NOT the
# library above.
OPENRIG_CLIENT_SKILLS=

# The force-compaction helper for omp seats. Blank means: look for `forcecompact` on PATH.
# 4GENTEAM_FORCECOMPACT=/path/to/forcecompact

# A directory holding Claude Code project logs, used as the fallback session-log source for a
# claude-code seat. Blank means: the runtime's own default.
4GENTEAM_CLAUDE_PROJECTS=

# The compaction supervisor's limits. A blank value means: use the default shown. A value that is
# present and not a whole number is refused by name instead of being ignored.
# COMPACT_LIMIT_TOKENS is the soft limit: the seat is told to find its own safe point, and it is
# compacted once it goes quiet. COMPACT_WARN_TOKENS is urgent: compacted without waiting for quiet.
# COMPACT_HARD_TOKENS is the ceiling at which the running turn is aborted and compaction forced.
# COMPACT_QUIET_SECONDS is how long without output counts as quiet.
COMPACT_LIMIT_TOKENS=150000
COMPACT_WARN_TOKENS=250000
COMPACT_HARD_TOKENS=300000
COMPACT_QUIET_SECONDS=15

# DeepSeek peak billing. The gate refuses to START or RESUME a seat whose model is `deepseek/` inside a
# peak window (01:00-04:00 and 06:00-10:00 UTC, Monday-Friday), because that is the expensive rate. On
# by default, since the expensive default is the one nobody had to remember. `4genteam offpeak` answers
# the schedule and its exit code is the answer (0 off-peak, 1 peak); `4genteam offpeak set off` writes
# this line for you. A value that is not 1/on/0/off is refused by name, never read as the default.
OFFPEAK_ONLY=1

# The two variables the shell gate used, kept under the same names so a machine switching to this client
# keeps its behavior: pin the instant the schedule is read at (a test, or a clock you do not trust), and
# a file of YYYY-MM-DD dates, one per line, that bill at the off-peak rate all day. Blank means: the
# real clock, and no holidays.
# OFFPEAK_UTC=2026-10-10 12:00
# DEEPSEEK_HOLIDAYS=/path/to/holidays.txt
